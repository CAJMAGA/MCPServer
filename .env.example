# Windows MCP Server configuration
# Copy this file to .env and adjust values for your environment.
# Never commit the populated .env file.

# Comma-separated list of approved SSH hosts or ~/.ssh/config aliases.
# Requests for any other target are rejected. Leave empty to deny all.
MCP_ALLOWED_HOSTS=windows-lab

# Seconds to wait for the SSH connection to be established.
MCP_SSH_CONNECT_TIMEOUT=5

# Maximum seconds a remote PowerShell command may run before it is aborted.
MCP_COMMAND_TIMEOUT=30

# Comma-separated list of Windows service names that get_windows_service may
# query. Names are matched exactly (case-sensitive). Allowed characters:
# letters, digits, _ . - $. Leave empty to deny all service queries.
# Set to ALL (on its own) to allow any service name; requested names must
# still use the allowed characters (no spaces or wildcards).
MCP_ALLOWED_SERVICES=Spooler,WinRM,W32Time,EventLog
# MCP_ALLOWED_SERVICES=ALL

# Audit log file (JSON lines). Relative paths are resolved from the project
# directory. Defaults to logs/audit.jsonl.
MCP_AUDIT_LOG_FILE=logs/audit.jsonl

# change this to the user you wish for the .ssh directory to pull from ex. /home/mcpadmin
SSH_HOME=/home/user
